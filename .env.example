# Smart Locking Mobile - Environment Variables Template
# Copy this file to .env and adjust values for local development

# API Configuration
EXPO_PUBLIC_API_URL=https://api.smartlocking.example.com/api
EXPO_PUBLIC_API_TIMEOUT=15000

# EAS projectId is configured in app.json. Set this only to override it.
# EXPO_PUBLIC_EAS_PROJECT_ID=

# Parcel UI: off = real API, active = demo parcels, empty = demo empty state.
# Authentication always uses the real backend.
EXPO_PUBLIC_PARCEL_DEMO=off
