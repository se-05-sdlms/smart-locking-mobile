# Smart Locking Mobile - Environment Variables Template
# Copy this file to .env and adjust values for local development

# API Configuration
EXPO_PUBLIC_API_URL=https://api.smartlocking.example.com/api
EXPO_PUBLIC_API_TIMEOUT=15000

# Required only for Expo push notifications on a physical device
EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-id

# Optional text diagnostics in development builds only; logs selected API text fields.
# Leave disabled normally. Never share captures containing personal notification content.
EXPO_PUBLIC_DEBUG_TEXT_ENCODING=false
