{
  "expo": {
    "name": "Boxora",
    "slug": "boxora",
    "owner": "wy_kowjbu",
    "extra": {
      "eas": {
        "projectId": "535b5783-6307-4982-a796-1aa71e988fef"
      }
    },
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "boxora",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#fffdfc"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.wykowjbu.boxora"
    },
    "plugins": [
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "neverForLocation": true,
          "bluetoothAlwaysPermission": "Boxora dùng Bluetooth để kết nối đúng tủ ở gần và chuyển lệnh mở ngăn bạn được phép sử dụng."
        }
      ],
      "./plugins/with-local-api",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#fffdfc"
        }
      ],
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    }
  }
}
