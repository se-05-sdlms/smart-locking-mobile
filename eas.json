{
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_PARCEL_DEMO": "off" }
    },
    "preview-demo": {
      "extends": "preview",
      "env": { "EXPO_PUBLIC_PARCEL_DEMO": "active" }
    },
    "preview-empty": {
      "extends": "preview",
      "env": { "EXPO_PUBLIC_PARCEL_DEMO": "empty" }
    }
  }
}
